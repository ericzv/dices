// Icone e dados do executavel no Windows.
#include <winver.h>

1 ICON "icone.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604B0"
        BEGIN
            VALUE "FileDescription", "Dado em Casa"
            VALUE "ProductName",     "Dado em Casa"
            VALUE "FileVersion",     "0.1.0"
            VALUE "ProductVersion",  "0.1.0"
            VALUE "OriginalFilename", "DadoEmCasa.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200
    END
END
