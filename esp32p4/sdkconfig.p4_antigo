# Para placas com ESP32-P4 anterior a v3.0 (as primeiras JC8012P4A1). O
# esptool mostra a revisao ao gravar ("Chip is ESP32-P4 (revision v1.3)").
# Use junto com o sdkconfig.defaults, a partir de um sdkconfig apagado:
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.p4_antigo" build
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y
